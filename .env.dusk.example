# Environment for `php artisan dusk`. Copy to .env.dusk.local and run
# `php artisan key:generate --env=dusk.local`.
APP_NAME=Atrium
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Browser tests sign in with a password only; the e-mail code has its own PHPUnit tests.
ATRIUM_2FA_ENABLED=false
ATRIUM_TIMINGS=false

# The demo shop of `php artisan atrium:install --demo`.
ATRIUM_DEMO=true

{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alveby/atrium-skeleton",
    "type": "project",
    "description": "Atrium demo application: one admin for any number of multilingual sites, with a 1C-Bitrix migrator",
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "bitrix",
        "multisite",
        "i18n"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "alveby/atrium": "@dev",
        "alveby/atrium-2fa": "@dev",
        "alveby/atrium-ai": "@dev",
        "alveby/atrium-backup": "@dev",
        "alveby/atrium-brands": "@dev",
        "alveby/atrium-catalog": "@dev",
        "alveby/atrium-custom-fields": "@dev",
        "alveby/atrium-docs": "@dev",
        "alveby/atrium-errors": "@dev",
        "alveby/atrium-faq": "@dev",
        "alveby/atrium-forms": "@dev",
        "alveby/atrium-monitoring": "@dev",
        "alveby/atrium-menus": "@dev",
        "alveby/atrium-search": "@dev",
        "alveby/atrium-news": "@dev",
        "alveby/atrium-pages": "@dev",
        "alveby/atrium-reviews": "@dev",
        "alveby/atrium-seo": "@dev",
        "alveby/atrium-social-login": "@dev",
        "alveby/atrium-solutions": "@dev",
        "alveby/atrium-stores": "@dev",
        "alveby/atrium-team": "@dev",
        "alveby/atrium-theme": "@dev",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "alveby/atrium-bitrix": "@dev",
        "alveby/atrium-wordpress": "@dev",
        "fakerphp/faker": "^1.23",
        "infection/infection": "^0.35",
        "larastan/larastan": "^3.15",
        "laravel/dusk": "^8.8",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/flysystem-ftp": "^3.36",
        "league/flysystem-sftp-v3": "^3.36",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Atrium\\Ci\\": "scripts/ci/",
            "Atrium\\Admin\\Tests\\": "packages/admin/tests/",
            "Atrium\\Ai\\Tests\\": "packages/ai/tests/",
            "Atrium\\Backup\\Tests\\": "packages/backup/tests/",
            "Atrium\\Bitrix\\Tests\\": "packages/bitrix/tests/",
            "Atrium\\Brands\\Tests\\": "packages/brands/tests/",
            "Atrium\\Catalog\\Tests\\": "packages/catalog/tests/",
            "Atrium\\CustomFields\\Tests\\": "packages/custom-fields/tests/",
            "Atrium\\Docs\\Tests\\": "packages/docs/tests/",
            "Atrium\\Errors\\Tests\\": "packages/errors/tests/",
            "Atrium\\Faq\\Tests\\": "packages/faq/tests/",
            "Atrium\\Forms\\Tests\\": "packages/forms/tests/",
            "Atrium\\Monitoring\\Tests\\": "packages/monitoring/tests/",
            "Atrium\\Menus\\Tests\\": "packages/menus/tests/",
            "Atrium\\Search\\Tests\\": "packages/search/tests/",
            "Atrium\\News\\Tests\\": "packages/news/tests/",
            "Atrium\\Pages\\Tests\\": "packages/pages/tests/",
            "Atrium\\Reviews\\Tests\\": "packages/reviews/tests/",
            "Atrium\\Seo\\Tests\\": "packages/seo/tests/",
            "Atrium\\Solutions\\Tests\\": "packages/solutions/tests/",
            "Atrium\\Stores\\Tests\\": "packages/stores/tests/",
            "Atrium\\Team\\Tests\\": "packages/team/tests/",
            "Atrium\\Theme\\Tests\\": "packages/theme/tests/",
            "Atrium\\TwoFactor\\Tests\\": "packages/two-factor/tests/",
            "Atrium\\SocialLogin\\Tests\\": "packages/social-login/tests/",
            "Atrium\\WordPress\\Tests\\": "packages/wordpress/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/ci"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "alveby/atrium": "0.1.x-dev",
                    "alveby/atrium-2fa": "0.1.x-dev",
                    "alveby/atrium-ai": "0.1.x-dev",
                    "alveby/atrium-backup": "0.1.x-dev",
                    "alveby/atrium-bitrix": "0.1.x-dev",
                    "alveby/atrium-brands": "0.1.x-dev",
                    "alveby/atrium-catalog": "0.1.x-dev",
                    "alveby/atrium-custom-fields": "0.1.x-dev",
                    "alveby/atrium-docs": "0.1.x-dev",
                    "alveby/atrium-errors": "0.1.x-dev",
                    "alveby/atrium-faq": "0.1.x-dev",
                    "alveby/atrium-forms": "0.1.x-dev",
                    "alveby/atrium-monitoring": "0.1.x-dev",
                    "alveby/atrium-menus": "0.1.x-dev",
                    "alveby/atrium-search": "0.1.x-dev",
                    "alveby/atrium-news": "0.1.x-dev",
                    "alveby/atrium-pages": "0.1.x-dev",
                    "alveby/atrium-reviews": "0.1.x-dev",
                    "alveby/atrium-seo": "0.1.x-dev",
                    "alveby/atrium-social-login": "0.1.x-dev",
                    "alveby/atrium-solutions": "0.1.x-dev",
                    "alveby/atrium-stores": "0.1.x-dev",
                    "alveby/atrium-team": "0.1.x-dev",
                    "alveby/atrium-theme": "0.1.x-dev",
                    "alveby/atrium-wordpress": "0.1.x-dev"
                }
            }
        }
    ]
}

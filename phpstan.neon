includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # 5 for now: the ported admin still lacks array shapes (level 6 adds ~190
    # of those). Raising it is on the plan.
    level: 5
    # A cache per checkout: the default one in the system temp folder is shared
    # by every checkout on the machine, and two runs at once corrupt it.
    tmpDir: build/phpstan
    paths:
        - app
        - bin/ci
        - scripts
        - packages/admin/src
        - packages/ai/src
        - packages/backup/src
        - packages/bitrix/src
        - packages/brands/src
        - packages/catalog/src
        - packages/docs/src
        - packages/faq/src
        - packages/forms/src
        - packages/news/src
        - packages/pages/src
        - packages/reviews/src
        - packages/solutions/src
        - packages/stores/src
        - packages/team/src
        - packages/theme/src
    # Package config files read env() like the application's do.
    configDirectories:
        - config
        - packages/admin/config
        - packages/ai/config
        - packages/backup/config
        - packages/bitrix/config
        - packages/docs/config
        - packages/forms/config
        - packages/solutions/config
    # Larastan learns model columns from migrations; the package ships its own.
    databaseMigrationsPath:
        - database/migrations
        - packages/admin/database/migrations
        - packages/ai/database/migrations
        - packages/brands/database/migrations
        - packages/catalog/database/migrations
        - packages/faq/database/migrations
        - packages/forms/database/migrations
        - packages/news/database/migrations
        - packages/pages/database/migrations
        - packages/reviews/database/migrations
        - packages/stores/database/migrations
        - packages/team/database/migrations
        - vendor/laravel/sanctum/database/migrations

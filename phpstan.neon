includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # 5 for now: the ported admin still lacks array shapes (level 6 adds ~190
    # of those). Raising it is on the plan.
    level: 5
    paths:
        - app
        - packages/admin/src
        - packages/bitrix/src
        - packages/theme/src
    # Larastan learns model columns from migrations; the package ships its own.
    databaseMigrationsPath:
        - database/migrations
        - packages/admin/database/migrations
        - vendor/laravel/sanctum/database/migrations
    ignoreErrors:
        # Package traits are used by applications, not by the package itself.
        -
            identifier: trait.unused
            path: packages/*/src/Traits/*

{
    "name": "alveby/atrium-language",
    "description": "Atrium's own language: a typed tree shared by formulas, rules and plugins, an Excel-like formula parser in Russian and English, and an interpreter with limits",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "atrium",
        "formulas",
        "expression-language",
        "interpreter",
        "excel"
    ],
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "brick/math": "^1.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "alveby/atrium": "^0.2",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "alveby/atrium": "Lets modules add formula functions through the hook registry atrium.language.functions"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Language\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Language\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atrium\\Language\\LanguageServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

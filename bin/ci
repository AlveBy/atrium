declare(strict_types=1);

/*
 * The checks of GitHub Actions on this machine. Run it before every push:
 *
 *   bin/ci --changed
 *
 * bin/ci --help lists the steps and options; docs/testing.md has the rules.
 */

$root = dirname(__DIR__);

if (! is_file($root.'/vendor/autoload.php')) {
    fwrite(STDERR, "Run composer install first.\n");
    exit(2);
}

require $root.'/vendor/autoload.php';

exit((new Atrium\Ci\Ci($root))->run(array_slice($argv, 1)));
